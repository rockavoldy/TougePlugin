<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Npgsql" />
    </ItemGroup>

    <ItemGroup>
        <!-- Includes the parts of split scripts, such as lua\hud\*.lua. -->
        <None Update="lua\**\*.lua;lua\**\parts.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- HUD assets served to clients. Listed explicitly because the shared
         Plugins/Directory.Build.props wwwroot glob does not resolve for this project. -->
    <ItemGroup>
        <None Update="wwwroot\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
