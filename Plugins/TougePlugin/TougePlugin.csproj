<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Npgsql" />
    </ItemGroup>

    <ItemGroup>
        <None Update="lua\hud.lua">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="lua\teleport.lua">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="lua\timing.lua">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- HUD assets served to clients. Listed explicitly because the shared
         Plugins/Directory.Build.props wwwroot glob does not resolve for this project. -->
    <ItemGroup>
        <None Update="wwwroot\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
